{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["src", "test", "vitest.config.ts", "../src/domain/model.ts", "../src/data/demo.ts"]
}
